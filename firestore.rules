rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 25)) &&
             (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 20)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 60)) &&
             (!('occupation' in data) || (data.occupation is string && data.occupation.size() <= 60)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidActivityLog(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.action is string && data.action in ['LOGIN', 'REGISTER', 'UPDATE_PROFILE'] &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 160 &&
             data.deviceLabel is string && data.deviceLabel.size() >= 1 && data.deviceLabel.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'fullName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'email', 'phoneNumber', 'birthDate',
                         'city', 'occupation', 'bio', 'photoUrl', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName', 'email', 'phoneNumber', 'birthDate',
                         'city', 'occupation', 'bio', 'photoUrl', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /activity_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll(['userId', 'action', 'description', 'deviceLabel', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'action', 'description', 'deviceLabel', 'createdAt']) &&
                         isValidActivityLog(incoming());

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
